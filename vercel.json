{
  "version": 2,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/customers/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/customers",
      "destination": "/api/index.js"
    },
    {
      "source": "/products/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/products",
      "destination": "/api/index.js"
    },
    {
      "source": "/wishlist/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/wishlist",
      "destination": "/api/index.js"
    },
    {
      "source": "/cart/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/cart",
      "destination": "/api/index.js"
    },
    {
      "source": "/orders/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/orders",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets/|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
